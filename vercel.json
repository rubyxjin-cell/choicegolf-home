{
  "rewrites": [
    {
      "source": "/og/:t",
      "destination": "/api/og?t=:t"
    },
    {
      "source": "/jung",
      "has": [
        {
          "type": "host",
          "value": "sunskygolf.com"
        }
      ],
      "destination": "/sunrise/index.html?s=jung"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "sunskygolf.com"
        }
      ],
      "destination": "/sunrise/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.sunskygolf.com"
        }
      ],
      "destination": "https://sunskygolf.com/:path*",
      "permanent": true
    },
    {
      "source": "/product.html",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(kakaotalk-scrap|facebookexternalhit|Facebot|Twitterbot|Slackbot|Discordbot|LinkedInBot|TelegramBot|WhatsApp|Daum|NaverBot|Yeti).*"
        }
      ],
      "destination": "/api/c",
      "statusCode": 302
    }
  ]
}
